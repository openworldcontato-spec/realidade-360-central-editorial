{
  "name": "Story",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Brasil",
        "Pol\u00edtica",
        "Economia",
        "Justi\u00e7a",
        "Seguran\u00e7a",
        "Mundo",
        "Tecnologia",
        "Sociedade",
        "Viral"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Detectada",
        "Monitorando",
        "Selecionada",
        "Em produ\u00e7\u00e3o",
        "Revis\u00e3o",
        "Pronta",
        "Publicada",
        "Arquivada"
      ],
      "default": "Detectada"
    },
    "trend": {
      "type": "string",
      "enum": [
        "\u00daltima hora",
        "Em alta",
        "Acelerando",
        "Monitorar"
      ],
      "default": "Monitorar"
    },
    "opportunity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "score_band": {
      "type": "string",
      "enum": [
        "PUBLICAR AGORA",
        "ALTO POTENCIAL",
        "ACOMPANHAR",
        "BAIXA PRIORIDADE"
      ],
      "default": "BAIXA PRIORIDADE"
    },
    "score_reason": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "what_happened": {
      "type": "string"
    },
    "why_relevant": {
      "type": "string"
    },
    "source_count": {
      "type": "number",
      "default": 0
    },
    "primary_source_count": {
      "type": "number",
      "default": 0
    },
    "confirmed_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "divergent_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unconfirmed_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignored": {
      "type": "boolean",
      "default": false
    },
    "monitoring": {
      "type": "boolean",
      "default": false
    },
    "search_query": {
      "type": "string"
    },
    "is_manual": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category",
    "status"
  ]
}