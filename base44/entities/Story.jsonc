{
  "name": "Story",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Brasil",
        "Pol\u00edtica",
        "Economia",
        "Justi\u00e7a",
        "Seguran\u00e7a",
        "Mundo",
        "Tecnologia",
        "Sociedade",
        "Viral"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Detectada",
        "Monitorando",
        "Selecionada",
        "Em produ\u00e7\u00e3o",
        "Revis\u00e3o",
        "Pronta",
        "Publicada",
        "Arquivada"
      ],
      "default": "Detectada"
    },
    "opportunity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "trend": {
      "type": "string",
      "enum": [
        "Em alta",
        "Acelerando",
        "Monitorar",
        "Est\u00e1vel"
      ],
      "default": "Monitorar"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "source_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category",
    "status"
  ]
}