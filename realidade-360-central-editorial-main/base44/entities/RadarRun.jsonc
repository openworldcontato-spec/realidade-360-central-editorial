{
  "name": "RadarRun",
  "type": "object",
  "properties": {
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "concluida",
        "erro"
      ],
      "default": "em_andamento"
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "search",
        "link"
      ],
      "default": "auto"
    },
    "stories_found": {
      "type": "number",
      "default": 0
    },
    "articles_found": {
      "type": "number",
      "default": 0
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "run_at",
    "status",
    "mode"
  ]
}