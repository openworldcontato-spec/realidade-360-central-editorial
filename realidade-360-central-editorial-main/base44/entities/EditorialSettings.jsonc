{
  "name": "EditorialSettings",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "default": "Realidade 360"
    },
    "tagline": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "editorial_tone": {
      "type": "string"
    },
    "preferred_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_notes": {
      "type": "string"
    }
  },
  "required": [
    "brand_name"
  ]
}